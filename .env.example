# Copy to .env and fill in ONE provider key.

# Provider: groq | deepseek
DATAPILOT_PROVIDER=deepseek

GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat

# Execution sandbox: local | docker
DATAPILOT_EXECUTOR=local
DATAPILOT_EXEC_TIMEOUT=60

# Safety limits
DATAPILOT_MAX_MESSAGES=12
DATAPILOT_MAX_TOKENS_PER_RUN=200000
DATAPILOT_MAX_UPLOAD_MB=50

# Team: round_robin | routed | selector
DATAPILOT_TEAM=round_robin
